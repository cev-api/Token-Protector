{
    "schemaVersion": 1,
    "id": "tokenprotector",
    "version": "${version}",
    "name": "TokenProtector",
    "description": "Client-side hardening against common Minecraft session-token reads. It serves fake session data to unauthorized callers while preserving vanilla authentication paths; it is not a security boundary against a hostile mod in the same JVM.",
    "authors": [
        "CevAPI"
    ],
    "contact": {
        "homepage": "https://github.com/cev-api",
        "sources": "https://github.com/cev-api/Token-Protector",
        "issues": "https://github.com/cev-api/Token-Protector/issues"
    },
    "license": "ARR",
    "icon": "TP.png",
    "environment": "client",
    "entrypoints": {
        "client": [
            "net.tokenprotector.TokenProtectorMod"
        ],
        "modmenu": [
            "net.tokenprotector.config.ModMenuIntegration"
        ]
    },
    "mixins": [
        "tokenprotector.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${loader_version}",
        "minecraft": "${minecraft_range}",
        "java": ">=${java_version}",
        "fabric-api": "*"
    },
    "suggests": {
        "modmenu": "*"
    }
}
